{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"rootDir": "."
	},
	"include": ["src/**/*.ts", "drizzle.config.ts"],
	"exclude": ["node_modules"],
	"ts-node": {
		"compilerOptions": {
			"module": "CommonJS"
		}
	}
}
