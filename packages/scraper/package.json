{
	"name": "scraper",
	"version": "1.0.0",
	"type": "module",
	"description": "Scrapes and analyzes data for The Pain Prism.",
	"main": "dist/main.js",
	"scripts": {
		"scrape": "node --loader ts-node/esm src/main.ts",
		"build": "tsc",
		"start": "node dist/main.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --loader ts-node/esm src/db/migrate.ts"
	},
	"dependencies": {
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.31.4",
		"node-cron": "^3.0.3",
		"openai": "^4.104.0",
		"pg": "^8.16.2",
		"playwright": "^1.53.1"
	},
	"devDependencies": {
		"@types/node": "^20.19.1",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.15.4",
		"drizzle-kit": "^0.22.8",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3"
	}
}
