## Backend API ###########
######################
# PostgreSQL Database Connection
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=pain_prism

# Host is host.docker.internal in the case that docker is running containers with Hyper V
# But it is just localhost in the case that its running containers in a WSL distro
DATABASE_URL=postgresql://myuser:mypassword@host.docker.internal:5432/pain_prism

JWT_SECRET=xyz
FRONTEND_HOST=http://localhost:5173